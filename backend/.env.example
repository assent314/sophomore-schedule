# 复制为 .env 后填写；.env 不会被提交到 git
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SCHEDULE_TIMEZONE=Asia/Shanghai
# 默认只允许本机。要让手机访问，改为 0.0.0.0，并在电脑设置里获取配对密钥。
SCHEDULE_HOST=127.0.0.1
SCHEDULE_PORT=8000
# 如已配置可信证书，手机地址可使用 https://电脑地址:8000
SCHEDULE_TLS_CERTFILE=
SCHEDULE_TLS_KEYFILE=
